# ==============================================================================
# The Central Report — Hostinger Apache / LiteSpeed Configuration
# Dynamic Client-Side SPA Fallbacks & Next.js Static Optimization
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── 1. Trailing Slash Normalization ──────────────────────────────────────────
  # Ensures clean URLs matching next.config.ts trailingSlash: true
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ $1/ [L,R=301]

  # ── 2. Dynamic Article SPA Fallback ──────────────────────────────────────────
  # When a visitor requests an article published after the latest build,
  # transparently route to the client-side fallback template to fetch live from WordPress GraphQL.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^article/([^/]+)/?$ /article/_fallback/index.html [L]

  # ── 3. Dynamic Category SPA Fallback ─────────────────────────────────────────
  # When a visitor requests a category not pre-rendered at build time,
  # transparently route to the category fallback template.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^category/([^/]+)/?$ /category/_fallback/index.html [L]

  # ── 4. Serve Directory Index File ────────────────────────────────────────────
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>

# ── 5. Standard Error Handling ─────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── 6. Gzip / Deflate Compression ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# ── 7. Static Asset Caching ────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Immutable Next.js static chunks
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # HTML pages should revalidate quickly so user gets freshest version
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
